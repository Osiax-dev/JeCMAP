# ------------------------------------------------------------------
# PRODUCTION — à vérifier avant chaque mise en ligne :
#   APP_ENV=production
#   APP_DEBUG=false            (jamais true en ligne : affiche le code et la config)
#   APP_URL=https://votre-domaine
#   LOG_LEVEL=warning
#   SESSION_SECURE_COOKIE=true (si le site est en HTTPS)
#   La racine web du serveur doit pointer sur le dossier public/
#   Ne jamais partager ni versionner le fichier .env (mots de passe, APP_KEY)
# ------------------------------------------------------------------
APP_NAME=JeCMAP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Africa/Porto-Novo
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Gmail : utiliser un mot de passe d'application (jamais le mot de passe du compte)
# Adresse qui reçoit les nouvelles demandes d'orientation
MAIL_JECMAP_ADMIN=

# Limite d'envoi des formulaires publics par adresse IP (relever pendant une séance en classe)
JECMAP_LIMITE_FORMULAIRES_MINUTE=10
JECMAP_LIMITE_FORMULAIRES_HEURE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
